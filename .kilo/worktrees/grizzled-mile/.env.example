# Copiar a .env y completar con valores locales.
# .env esta en .gitignore: nunca se commitea.
# En Docker Compose estos valores llegan como variables de entorno.

# Clave del usuario de PostgreSQL en desarrollo
POSTGRES_PASSWORD=replace_with_local_password

# Clave de firma del JWT (HS512). Debe tener al menos 64 bytes.
# Generar una con:
#   $bytes = New-Object byte[] 64
#   [Security.Cryptography.RandomNumberGenerator]::Fill($bytes)
#   [Convert]::ToBase64String($bytes)
JWT_SECRET=replace_with_a_random_secret_of_at_least_64_bytes_for_hs512_signing_xxxxxxxxxxxxxxxxxxxxxxxxxxx